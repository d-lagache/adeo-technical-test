// Modèle relationnel : voir docs/database-schema.md.
// Les contraintes CHECK (price, stock, notation) ne sont pas exprimables ici :
// elles sont ajoutées en SQL brut dans la migration initiale.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum AuthorType {
  amateur
  professional

  @@map("author_type")
}

model Product {
  id          Int      @id @default(autoincrement())
  reference   String   @unique @db.VarChar(20)
  name        String   @db.VarChar(255)
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("EUR") @db.Char(3)
  stock       Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  reviews     Review[]

  @@map("products")
}

model Author {
  id        Int        @id @default(autoincrement())
  firstName String     @map("first_name") @db.VarChar(100)
  lastName  String     @map("last_name") @db.VarChar(100)
  type      AuthorType
  reviews   Review[]

  @@unique([firstName, lastName, type], map: "authors_identity_key")
  @@map("authors")
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  authorId   Int      @map("author_id")
  notation   Int      @db.SmallInt
  comment    String   @db.Text
  reviewedAt DateTime @map("reviewed_at") @db.Timestamp

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  Author  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([productId, notation], map: "reviews_product_id_notation_idx")
  @@index([authorId], map: "reviews_author_id_idx")
  @@map("reviews")
}
