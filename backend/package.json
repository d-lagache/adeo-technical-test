{
  "name": "backend",
  "version": "0.0.1",
  "description": "API REST du catalogue produits (NestJS, Prisma, PostgreSQL)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "prestart": "npm run db:deploy",
    "start": "nest start",
    "prestart:dev": "npm run db:deploy",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm run db:deploy",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.1",
    "@nestjs/platform-express": "^12.6.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.2",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
