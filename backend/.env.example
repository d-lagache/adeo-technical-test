# Connexion à la base PostgreSQL lancée par docker-compose.yml (identifiants de dev)
DATABASE_URL=postgresql://adeo:adeo@localhost:5432/adeo

# Port HTTP de l'API (défaut : 3000)
PORT=3000

# Origine autorisée par CORS : URL du dashboard Vite (défaut : http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
